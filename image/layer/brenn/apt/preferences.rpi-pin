# Exact versions for everything that comes from the Raspberry Pi archive.
#
# That archive publishes no snapshot service, so a suite name alone does not
# identify a build. These pins are the only thing that makes two builds of the
# same commit resolve the same kernel and boot firmware.
#
# Priority 1001 is above the "never downgrade" threshold, so a newer version
# that has already slipped into a cache is rolled back rather than kept.
#
# Bumping a version here is a deliberate act: it changes what boots.

Package: linux-image-* linux-headers-* linux-kbuild-* linux-base-*
Pin: version 1:6.18.34-1+rpt1
Pin-Priority: 1001

Package: raspi-firmware
Pin: version 1:1.20260521-3
Pin-Priority: 1001

Package: firmware-brcm80211
Pin: version 1:20260519-1~bpo13+1+rpt1
Pin-Priority: 1001

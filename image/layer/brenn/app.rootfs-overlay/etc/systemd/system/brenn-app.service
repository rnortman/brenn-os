[Unit]
Description=Application payload

# Neither door a payload comes in by — the fetch or the baked stage — is
# required by or ordered before this unit, and that is deliberate.
#
# Required, either one would be started again by every start of this unit —
# each activation's restart and each Restart= — because a unit its condition
# skipped is left inactive, and its condition re-read. Baking and unbaking flip
# those conditions at run time, so a restart could stage the baked payload back
# over a pushed one, or fetch over a baked one. Wants= does the same.
#
# Ordered after the fetch, this unit would wait for a start job that itself
# waits for the network: on an offline baked boot, the wait-online timeout for
# a unit whose only act is to be skipped, and after a bake, a fetch's retry
# loop in flight.
#
# The health gate is what pulls both obtaining units into every boot, and the
# activate step's restart is what starts this one on each new payload. At boot
# the condition below does the ordering: a start before any payload is current
# is skipped, and the activation's restart follows.
ConditionPathExists=/run/brenn-app/current/run

StartLimitIntervalSec=0

[Service]
ExecStart=/run/brenn-app/current/run
WorkingDirectory=/run/brenn-app/current
Environment=BRENN_APP_ROOT=/run/brenn-app/current
Environment=BRENN_DATA_DIR=/data/app
Environment=BRENN_CA_FILE=/run/brenn/provisioning/ca/brenn-ca.pem

# Scratch space is RAM, inside the same capped mount as the payload, so
# nothing a payload writes by habit lands on flash.
Environment=TMPDIR=/run/brenn-app/scratch

# Unprivileged, always. A payload arrives over the network far more often than
# the image does and with none of its review, so it is not a channel that may
# reach root; anything that genuinely needs privilege belongs in the image,
# where it is signed and reversible.
User=app
Group=app

Restart=on-failure
RestartSec=5s

# Nearly free on a read-only root, and worth having for the case the root is
# not the only thing to protect. The writable exceptions are the two places
# the contract says a payload may write: its scratch space in RAM, and the
# persistent directory for the rare asset worth keeping across a reboot. Both
# are named by their real paths, since /data is a symlink and what is unmasked
# here is the destination.
#
# Device nodes stay visible. Cameras, audio, the servo bus and the IMU are the
# reason this device exists, and access to them is granted by the groups the
# `app` account is in.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/brenn-app/scratch /persistent/app /persistent/models
NoNewPrivileges=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

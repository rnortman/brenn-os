#!/bin/sh
#
# Obtain the application payload and make it the current one.
#
#   brenn-app-fetch [--once]
#
# Where it comes from is site configuration, so it arrives with the
# provisioning generation: a URL, over TLS to a provisioned trust anchor, with
# the unit's own provisioned certificate presented on the connection. That is
# the whole of the trust, in both directions: the server is trusted because
# its certificate chains to the generation's anchor and names the URL's host;
# what it serves, it serves to this unit, because the unit proved who it is
# — which is what lets a payload carry secrets meant for this unit. Nothing
# about the payload's content is known here — it is a tar archive of a
# directory tree, and the only thing asked of it is the entry point the
# contract requires, which the activate step is what checks.
#
# It retries until it succeeds. That is deliberate and it is why the retry is a
# loop in here rather than Restart= on the unit: the health gate waits on this
# unit, and a unit that failed once would fail the gate's job with nothing to
# re-run it when the server came back. On a trial boot the deadman timer ends
# the wait by rebooting to what was working; on an ordinary boot nobody is
# waiting, and the device converges on a payload whenever the network returns.
#
# `--once` makes a single attempt and reports. That is the interactive form —
# an operator asking for a fresh payload wants an answer, not a program that
# waits out the afternoon.
#
# A baked device does not fetch at boot: the unit's condition skips it. The
# loop asks the same question again on every attempt, because an operator can
# bake while it is waiting out an outage, and a fetch that then succeeded would
# replace the baked payload without anyone asking. `--once` does not ask: it is
# an operator requesting the fetched payload on a device they know is baked.

set -eu

link=${BRENN_PROVISIONING_LINK:-/run/brenn/provisioning}
curl_cmd=${BRENN_APP_CURL:-curl}

# Siblings are found beside this program, through whatever link the caller
# reached it by. The link is resolved first because the documented way in is a
# bare command over SSH, which arrives here as the path entry — a directory
# holding links and none of the rest of the runner.
here=$(dirname -- "$(readlink -f -- "$0")")

brenn_app_activate=${BRENN_APP_ACTIVATE:-${here}/brenn-app-activate}

# The provisioning contract, shared with the programs that write and check a
# generation. Reading the fetch configuration with anything else is a device
# that accepts what the bench refuses, so it is sourced rather than reimplemented
# — the two programs are installed side by side, and the override is what lets
# them be checked from the tree they are built out of.
lib=${BRENN_CONFIG_LIB:-${here}/brenn-config-lib.sh}

app_lib=${BRENN_APP_LIB:-${here}/brenn-app-lib.sh}

# The first wait and the ceiling it grows to, in seconds. Backing off matters
# because the common failure is a server that is down for a while and a device
# that would otherwise ask it several times a second for hours.
retry_base=${BRENN_APP_RETRY_BASE:-5}
retry_max=${BRENN_APP_RETRY_MAX:-300}

# Every attempt has to end, or the retry above never happens: a connection that
# is accepted and then stalls — a wedged server, a dropped NAT entry, a black
# hole — is neither a success nor a failure, and the unit is deliberately
# allowed to wait forever. So a transfer that stops moving is abandoned and
# becomes the next attempt. The rate is low enough not to fail a slow link and
# the window long enough not to trip on a server that pauses to think.
connect_timeout=${BRENN_APP_CONNECT_TIMEOUT:-30}
stall_bytes=${BRENN_APP_STALL_BYTES:-1024}
stall_seconds=${BRENN_APP_STALL_SECONDS:-60}

conf="${link}/app/fetch.conf"
ca="${link}/ca/brenn-ca.pem"
crt="${link}/app/client.crt"
key="${link}/app/client.key"

once=no
case "${1:-}" in
	--once) once=yes ;;
	"") ;;
	*)
		echo "usage: $(basename -- "$0") [--once]" >&2
		exit 2
		;;
esac

die() {
	echo "brenn-app-fetch: $*" >&2
	exit 1
}

note() {
	echo "brenn-app-fetch: $*" >&2
}

[ -r "$lib" ] || die "no provisioning contract library at ${lib}"
# shellcheck source=../../../../provisioning.rootfs-overlay/usr/lib/brenn/brenn-config-lib.sh
. "$lib"

[ -r "$app_lib" ] || die "no payload library at ${app_lib}"
# shellcheck source=brenn-app-lib.sh
. "$app_lib"

app_dir=$brenn_app_dir
releases="${app_dir}/releases"

[ -r "$conf" ] || die "no fetch configuration at ${conf}"
[ -r "$ca" ] || die "no trust anchor at ${ca}"
[ -r "$crt" ] || die "no client certificate at ${crt}"
[ -r "$key" ] || die "no client key at ${key}"
[ -d "$releases" ] || die "no payload store at ${releases}"

url=$(brenn_conf_value "$conf" URL)

[ -n "$url" ] || die "${conf} names no URL="

# Refused rather than ignored: a digest line is what a generation assembled by
# older tooling carries, and a reader that let it stand would have an operator
# believe something is checked when nothing reads it. This image pins the URL
# and the anchor.
[ -z "$(brenn_conf_value "$conf" SHA256)" ] ||
	die "${conf} names a SHA256=; this image pins the URL and the anchor, not a digest — remove the line"

# Enforced here because this is where the connection is made: nothing this
# device fetches may travel in the clear.
case "$url" in
	https://*) ;;
	*) die "${conf} names a URL that is not https://" ;;
esac

# The status an attempt returns when it found the device baked: not a failure
# to retry, and not a payload obtained either.
baked_status=10

# One download, unpacked and handed to the activate step. Anything
# that goes wrong leaves nothing behind: a half-written archive or a partly
# unpacked tree that survived would be indistinguishable from a payload.
#
# The store is capped RAM, so a download that this process is not around to
# clean up after — killed mid-transfer, which is the case the unit's Restart=
# exists for — has to be swept by whatever writes the store next, or a few of
# them fill the mount and every later attempt fails for want of space.
#
# Asked under the lock a bake holds while it writes the baked store's link, so
# a bake either finished before this attempt, and the attempt sees it, or is
# waiting for the lock, and installs over whatever this attempt installs.
attempt_locked() {
	tmp="${app_dir}/.download.$$"

	if [ "$once" = no ] && brenn_app_baked_active; then
		note "device is baked; nothing to fetch"
		return "$baked_status"
	fi

	brenn_app_sweep

	# --proto and --proto-redir, not just the check on the configured URL
	# above: curl follows a redirect into plaintext by default, and the hop
	# that carries the payload is the one that has to be encrypted.
	#
	# TODO(app-payload-signing): the payload is trusted because the anchored
	# server served it; a signature would let the device check the publisher,
	# not the server.
	if ! "$curl_cmd" --fail --silent --show-error --location \
		--proto '=https' --proto-redir '=https' \
		--connect-timeout "$connect_timeout" \
		--speed-limit "$stall_bytes" --speed-time "$stall_seconds" \
		--cacert "$ca" \
		--cert "$crt" --key "$key" \
		--output "$tmp" -- "$url"; then
		note "could not download ${url}"
		rm -f -- "$tmp"
		return 1
	fi

	rc=0
	brenn_app_install "$tmp" "$(brenn_app_release_id fetch)" || rc=1
	rm -f -- "$tmp"
	return "$rc"
}

# The attempt, with the store to itself. The boot-time retry, an operator's
# resync, a bake and a tree pushed from a workstation can all be in flight at
# once, and each of them ends by removing every release that is not the one it
# just made current — interleaved, two of them delete each other's tree and
# leave nothing running and nothing to say why. A subshell, so the lock is
# released between attempts.
attempt() (
	brenn_app_lock || return 1
	attempt_locked
)

# shellcheck disable=SC2016  # expanded when the program exits
brenn_app_on_exit 'rm -f -- "${app_dir}/.download.$$"'

delay=$retry_base
while :; do
	rc=0
	attempt || rc=$?
	if [ "$rc" -eq 0 ] || [ "$rc" -eq "$baked_status" ]; then
		exit 0
	fi
	if [ "$once" = yes ]; then
		die "the payload could not be obtained"
	fi
	note "retrying in ${delay}s"
	sleep "$delay"
	delay=$((delay * 2))
	[ "$delay" -le "$retry_max" ] || delay=$retry_max
done

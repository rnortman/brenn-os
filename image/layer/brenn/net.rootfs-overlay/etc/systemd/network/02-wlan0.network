# The wireless link. The supplicant authenticates it; this only carries the
# address configuration, so it is the same as the wired link but for one thing:
# it accepts router advertisements, and the wired link does not. This is the
# link a unit uses on networks the operator does not control, and its IPv6
# policy is left at networkd's default.

[Match]
Name=wlan0

[Network]
DHCP=yes
# The device answers its own name on this link too — it is the link a unit off
# its own network is reached over. Stated per link as well as globally in the
# resolver's configuration, because which way the default falls is a property of
# how systemd was built.
MulticastDNS=yes

[DHCPv4]
SendHostname=yes
UseDomains=yes

[Link]
RequiredForOnline=yes

# Every package the reachy image installs.
#
# Written from a real build and reviewed before it was baked, package by
# package: an unexpected entry here is a finding, not a line to add. The
# comments say where each group comes from, which is what makes the review
# repeatable — a package with no attribution is one nobody chose.
#
# Comments and blank lines are stripped by the test, so the grouping is for
# the reader.

# Declared by our own layers, exhaustively and on purpose: the payload
# runtime, the update client, the log shipper, the remote access, the radio
# stack. Each one is named in a layer under image/layer/brenn.
curl
dfu-util
iproute2
iw
openssh-server
python3-minimal
rauc
rauc-service
systemd-journal-remote
wireless-regdb
wpasupplicant
zstd

# What those declarations drag in. Named separately from the base below so
# that a payload package growing a new dependency is visible as such: the full
# python3 (dfu-util depends on it), the ssh client-side pieces, dbus for
# rauc's control interface, and the TLS/HTTP and netlink libraries curl,
# journal upload, the supplicant and the link tools are built against.
#
# The seven libraries and utilities iproute2 pulls — libbpf1, libcap2-bin,
# libelf1t64, libmnl0, the libtirpc pair and libxtables12 — are read from a
# build, like every other line here. iw needs nothing the supplicant did not
# already bring.
dbus
dbus-bin
dbus-daemon
dbus-session-bus-common
dbus-system-bus-common
libbpf1
libbrotli1
libcap2-bin
libcbor0.10
libcurl3t64-gnutls
libcurl4t64
libedit2
libelf1t64
libfido2-1
libjson-glib-1.0-0
libjson-glib-1.0-common
libmicrohttpd12t64
libmnl0
libnghttp2-14
libnghttp3-9
libngtcp2-16
libngtcp2-crypto-gnutls8
libnl-3-200
libnl-genl-3-200
libnl-route-3-200
libpcsclite1
libpsl5t64
libpython3-stdlib
libpython3.13-minimal
libpython3.13-stdlib
librtmp1
libssh2-1t64
libtirpc-common
libtirpc3t64
libxtables12
openssh-client
openssh-sftp-server
python3
python3.13
python3.13-minimal

# Boot and update machinery: the pinned kernel and its firmware, the initramfs
# that resolves the by-slot root, the filesystem tools the layout's partitions
# need, and systemd itself. rsync is here because raspi-firmware depends on it,
# and mmc-utils because the layout's eMMC partition-table-protect step
# installs it.
cpio
dosfstools
dracut-install
e2fsprogs
initramfs-tools
initramfs-tools-bin
initramfs-tools-core
klibc-utils
kmod
libcom-err2
libext2fs2t64
libklibc
libkmod2
libss2
libsystemd-shared
libsystemd0
libudev1
linux-base
linux-base-6.18.50+rpt-rpi-v8
linux-base-rpi-v8
linux-image-6.18.50+rpt-rpi-v8
linux-image-rpi-v8
logsave
mmc-utils
raspi-firmware
rsync
systemd
systemd-resolved
systemd-sysv
systemd-timesyncd
udev

# The carrier's radios, from the device family layers.
bluez-firmware
firmware-brcm80211

# The carrier's audio, declared by the reachy profile layer alongside the rules
# that permission the same board's USB node. The mic array is a USB audio class
# device and the application opens it through ALSA's own library; there is no
# sound server, because the application is the card's only user. `libasound2` is
# a virtual name in trixie, provided by libasound2t64, and libasound2-data — the
# library's configuration files — is the whole of the closure it drags in.
libasound2-data
libasound2t64

# The apt stack, retained deliberately. apt is how the build installs every
# layer, so purging it after the fact would run maintainer scripts against a
# half-dismantled package system for no gain: at runtime it can only act on a
# /var that is RAM, and the brenn-cleanup layer removes the two timers that
# would otherwise have systemd run it daily. Nothing schedules it, and no
# unattended-upgrades is installed. ca-certificates comes from the device
# family's security layer and is what any TLS client here judges a chain
# against.
apt
ca-certificates
debian-archive-keyring
libapt-pkg7.0
raspberrypi-archive-keyring
sqv


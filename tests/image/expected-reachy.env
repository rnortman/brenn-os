# What a reachy image is expected to contain. Sourced by the image tests.
#
# These are assertions about the product, not a copy of the build inputs: they
# are written here so that a change to a layer, a builder bump, or an upstream
# default silently altering the layout shows up as a failing test rather than
# as a surprise on a device.

# shellcheck shell=bash disable=SC2034  # consumed by the tests that source this

EXPECT_IMAGE_NAME=brenn-os-reachy

# Which build an image is, as a running system reports it. Debian ships
# /etc/os-release as a relative symlink into /usr/lib, so the field is written
# to — and read from — the file behind the link; the link's own shape is
# asserted, because an absolute one would point a build-time write at the build
# host's own os-release.
EXPECT_OS_RELEASE_LINK=../usr/lib/os-release
EXPECT_OS_RELEASE_FILE=/usr/lib/os-release

# Partition-table order is load-bearing: the firmware selects a boot slot by
# partition number, so boot_a must be partition 2 and boot_b partition 3.
EXPECT_PART_NAMES="bootconfig boot_a boot_b system_a system_b persistent"
EXPECT_PART_SIZES_MIB="32 256 256 3072 3072 7680"

# The smallest medium this profile may assume, in bytes (14.5 GiB). The eMMC
# on the target reports slightly more than this; the floor is what we are
# willing to build against, and the whole layout has to end below it.
EXPECT_MEDIA_MIN_BYTES=15569256448

# The tryboot selector. Committed state lives in [all]; the staged candidate
# lives in [tryboot]; committing an update swaps the two values. The firmware
# reads at most 512 bytes of this file.
EXPECT_AUTOBOOT="[all]
tryboot_a_b=1
boot_partition=2
[tryboot]
boot_partition=3"
EXPECT_AUTOBOOT_MAX_BYTES=512

# Read-only root, no resize, serial console retained as the recovery path short
# of a full reflash. Root is addressed through the slot link because both slots
# ship bit-identical and cannot be told apart by filesystem UUID.
EXPECT_CMDLINE="console=serial0,115200 console=tty1 root=/dev/disk/by-slot/active/system ro rootfstype=ext4 fsck.repair=yes rootwait"

# Hardware that must be configured for the carrier: servo UART, external WiFi
# antenna, fan controller, the head camera, IMU bus, CM4 USB host mode.
EXPECT_CONFIG_LINES="otg_mode=1
dtoverlay=uart3
enable_uart=1
dtparam=ant2
dtparam=i2c_vc=on
dtoverlay=i2c-fan,emc2301,i2c_csi_dsi,midtemp=45000,maxtemp=65000
dtoverlay=imx708,rotation=0,cam0
dtoverlay=i2c4,pins_8_9=1
arm_64bit=1
auto_initramfs=1
arm_boost=1"

# The one camera is declared explicitly above, so firmware probing must not also
# be on: the declared connector stays the single source of truth about what is
# attached, and a second source of camera overlays is how a camera ends up
# declared twice.
#
# The vendor configuration's second declaration is named here because this is the
# only place it is observable. Nothing is attached to that connector, so the
# overlay produces a failed probe rather than a device — the sensor never binds,
# no count on a device rises, and the only trace is imx708 and dw9807 errors in
# every boot log. A vendor-tree sync that restores the line is caught here or not
# at all.
EXPECT_CONFIG_ABSENT="camera_auto_detect=1
dtoverlay=imx708,rotation=0,cam1"

# Access to the carrier's hardware is granted by group membership, never by
# widening a device node to everyone. The rules this profile ships are listed
# whole: a second file appearing in the directory is a grant nobody reviewed.
#
# The three 99-rpi files are required, not tolerated. They create
# /dev/disk/by-slot/*, which the kernel command line and three of the fstab
# entries resolve root and boot through; an image without them does not boot.
EXPECT_UDEV_RULES_DIR=/etc/udev/rules.d
EXPECT_UDEV_RULES_FILES="70-brenn-usb-audio.rules
99-rpi-00-bootdev.rules
99-rpi-01-abslot.rules
99-rpi-05-image.rules"
EXPECT_UDEV_RULES_MODE=644

# The USB audio board, by the vendor and product ids it may enumerate under, and
# what a rule for them is allowed to say. There is one board and these are two
# generations of its firmware — the vendor's own id once it has been updated, the
# id of the module it is built on before that — so a device presents one of them
# and never both. Both are listed because both have to be permissioned.
#
# The vendor image granted these with MODE="0666"; the mode below plus a group
# the application account is already in reaches the same hardware without opening
# it to every account on the device.
EXPECT_USB_AUDIO_IDS="2886:001a
38fb:1001"
EXPECT_USB_AUDIO_MODE=0660
EXPECT_USB_AUDIO_GROUP=audio

# The only writable partition is the persistent one, reached through /data.
# Everything else that a general-purpose Debian would write to disk is either
# in RAM or not written at all.
EXPECT_DATA_LINK=persistent

# /var is an overlay: the baked filesystem read-only underneath, RAM on top.
# The lower half has to be somewhere the image assembly step does not move,
# which is why it is not /var itself.
EXPECT_VAR_LOWERDIR=/usr/share/factory/var
EXPECT_VAR_UPPERDIR=/run/brenn/var/upper
EXPECT_VAR_WORKDIR=/run/brenn/var/work
EXPECT_VAR_UPPER_MOUNT=/run/brenn/var

# What the baked /var is left as after assembly moves it aside. If this grows
# a directory, something is writing to a path the overlay no longer covers.
EXPECT_VAR_SKELETON="cache log spool tmp"

# Writable mounts the A/B layout would otherwise give us, held back by a
# drop-in that gives each unit a condition no device meets. See the brenn-state
# layer for why each one is unwanted, and why a mask is the wrong instrument:
# two of the fstab entries behind them carry no nofail, so masking the generated
# units makes systemd drop the whole local-fs.target start job without a word.
#
# The condition path below is what holds them: it reads in systemd's direction, so
# a file at that path is what would let all three mounts run. Nothing may ever
# create it — the mechanism is that one file never being there.
EXPECT_NEUTRALIZED_MOUNT_UNITS="bootfs.mount home.mount var-log-journal.mount"
EXPECT_NEVER_MOUNT_DROPIN=10-brenn-never.conf
EXPECT_NEVER_MOUNT_CONDITION=/etc/brenn/enable-state-mounts

# The fstab the layout generates during image assembly, as "device mountpoint
# type options" with runs of whitespace squeezed. It is written after every hook
# this repository can reach, so it is not ours to edit — the three entries that
# would write to flash are neutralised on the units generated from them.
# Written down whole so that a fourth entry is a failure rather than a discovery
# on hardware.
EXPECT_FSTAB_ENTRIES="/dev/disk/by-slot/active/system / ext4 ro,relatime,commit=30
/dev/disk/by-slot/active/boot /boot/firmware vfat defaults,ro,noatime,nofail
/dev/disk/by-slot/bootconfig /bootfs vfat defaults,rw,noatime,nofail
/persistent/home /home none bind,x-systemd.requires-mounts-for=/persistent/home,x-systemd.after=persistent.mount
/persistent/log/journal /var/log/journal none bind,x-systemd.requires-mounts-for=/persistent/log/journal,x-systemd.after=persistent.mount"

# The journal never touches the eMMC; it is held in RAM and uploaded.
EXPECT_JOURNAL_STORAGE=volatile

# The baked account set. The ids are pinned, so a file owned by 2000 on the
# persistent partition still belongs to the application after any update.
EXPECT_APP_USER=app
EXPECT_APP_UID=2000
EXPECT_APP_GID=2000
EXPECT_APP_HOME=/var/lib/brenn-app
EXPECT_APP_SHELL=/usr/sbin/nologin
EXPECT_APP_GROUPS="audio video input dialout i2c spi gpio render plugdev"

# Accounts allowed to have a real shell. root is key-only over SSH and has no
# password; anything else here would be a way in nobody designed.
EXPECT_LOGIN_ACCOUNTS="root"

# Site configuration is read from the generation published here, and from
# nowhere else. A service naming the partition path directly would read
# whichever generation happened to be committed at the moment it looked, which
# is the whole thing the trial mechanism exists to prevent.
EXPECT_PROVISIONING_LINK=/run/brenn/provisioning
EXPECT_PROVISIONING_STORE=/data/provisioning
EXPECT_SELECT_UNIT=brenn-config-select.service
EXPECT_SELECT_EXEC=/usr/lib/brenn/brenn-config-select

# The rules a generation has to satisfy, as a program, and the program that
# writes one. Both ship in the image because changing configuration on a running
# device goes through the same check and the same write the flash-time tool
# performs, and one implementation of each is what makes a generation that
# installs on a workstation one the device will accept.
EXPECT_VALIDATE_EXEC=/usr/lib/brenn/brenn-config-validate
EXPECT_INSTALL_EXEC=/usr/lib/brenn/brenn-config-install

# What the contract itself is: the file list, the classes, and the formats, as
# data that every program above reads. Absent from the image, nothing that
# touches a generation runs at all.
EXPECT_CONFIG_LIB=/usr/lib/brenn/brenn-config-lib.sh

# Changing configuration on a running device: install a candidate, try it for
# one boot, keep it only if the device is still reachable afterwards. The three
# programs are the three ends of that transaction.
EXPECT_APPLY_EXEC=/usr/lib/brenn/brenn-config-apply
EXPECT_CONFIG_COMMIT_EXEC=/usr/lib/brenn/brenn-config-commit
EXPECT_CONFIG_DEADMAN_EXEC=/usr/lib/brenn/brenn-config-deadman

EXPECT_CONFIG_COMMIT_UNIT=brenn-config-commit.service
EXPECT_CONFIG_DEADMAN_UNIT=brenn-config-deadman.service
EXPECT_CONFIG_DEADMAN_TIMER=brenn-config-deadman.timer

# How long a trial gets before the deadman ends it. One value for both kinds of
# trial — a configuration change and an operating-system update — because they
# are judged by the same health gate and the same things have to have happened
# for either to commit. Two timers implement it, because the two layers are
# independently composable; naming the window once is what keeps tuning one of
# them from silently making the pair disagree.
EXPECT_TRIAL_WINDOW=10min
EXPECT_CONFIG_DEADMAN_ONBOOT=$EXPECT_TRIAL_WINDOW

# What the selector publishes when this boot is running a candidate, and the
# only thing the two units above condition on. On the runtime filesystem, so it
# describes this boot and cannot outlive it.
EXPECT_CONFIG_TRIAL_FLAG=/run/brenn/config-trial

# Selection has to be settled before anything that reads its result: the
# journal (which files entries under the provisioned machine id), the network
# stack, and sshd.
#
# The network ordering only exists if the passive target it is expressed
# against is pulled into the boot, so the unit has to want it as well as
# precede it — asserted separately, because dropping the Wants= leaves an
# ordering that reads correctly and does nothing.

# The layout's own machine-id sync, emptied: the reset and the replacement, in
# that order. Both halves are named because an empty value list — a drop-in that
# lost its [Service] section — leaves the layout's unit running.
EXPECT_MACHINE_ID_SYNC_EXEC="
/bin/true"

# Every directory this image writes configuration into, as `path:depth`, swept
# for direct references to the store. The selector is deliberately not here: it
# is the one thing that reads the store, which is the whole point of it.
EXPECT_STORE_SWEEP_DIRS="/etc/udev/rules.d:1
/etc/systemd/system:2
/etc/systemd/network:1
/etc/systemd/system.conf.d:1
/etc/systemd/journald.conf.d:1
/etc/systemd/journal-upload.conf.d:1
/etc/systemd/timesyncd.conf.d:1
/etc/systemd/resolved.conf.d:1
/etc/ssh/sshd_config.d:1
/etc/rauc:1
/usr/lib/tmpfiles.d:1
/etc/default:1"

EXPECT_SELECT_AFTER="persistent.mount"
EXPECT_SELECT_BEFORE="sysinit.target systemd-journald.service network-pre.target sshd.service"
EXPECT_SELECT_WANTS="network-pre.target"

# The two links. Both take an address by DHCP and both count towards being
# online; the device layer's own files say neither, which is how a replacement
# that failed to apply would show up here.
EXPECT_LINK_FILES="01-eth0.network 02-wlan0.network"

# Online means any link, not every link: a device with no cable in it is not
# offline, and waiting for one to appear costs a boot's worth of timeout.
#
# The cost of --any is that a cable is enough on its own, so a device on a
# bench is online whatever its wireless credentials say. A trial meant to fail
# on bad credentials has to be run with no wired link, or it passes for the
# wrong reason.
EXPECT_WAIT_ONLINE_BIN=/usr/lib/systemd/systemd-networkd-wait-online
EXPECT_WAIT_ONLINE_UNIT=systemd-networkd-wait-online.service
EXPECT_WAIT_ONLINE_ARG=--any

# The wireless supplicant, and the provisioned file it takes every credential
# from. Only the instance for the onboard interface runs; the packaged
# system-wide service would start a second one with no configuration.
EXPECT_SUPPLICANT_BIN=/usr/sbin/wpa_supplicant
EXPECT_SUPPLICANT_UNIT=wpa_supplicant@wlan0.service
EXPECT_SUPPLICANT_TEMPLATE=/usr/lib/systemd/system/wpa_supplicant@.service
EXPECT_SUPPLICANT_MASKED=wpa_supplicant.service
EXPECT_SUPPLICANT_CONF=/run/brenn/provisioning/net/wpa_supplicant-wlan0.conf

# The regulatory database has to be installed for a country code to mean
# anything, and no country may be baked: which one applies is a property of
# where the device is, which makes it site configuration.
EXPECT_NET_PACKAGES="wpasupplicant wireless-regdb"
EXPECT_REGDOM_ABSENT=/etc/modprobe.d/cfg80211_regdomain.conf

# The clock. No time server is named in the image; a site with a local one
# provisions it, and the distribution's public pool is what happens otherwise.
EXPECT_NTP_DROPIN=/etc/systemd/timesyncd.conf.d/50-brenn-provisioned.conf
EXPECT_NTP_SOURCE=/run/brenn/provisioning/net/ntp.conf
EXPECT_TIMESYNCD_CONF=/etc/systemd/timesyncd.conf

# Remote access. Everything sshd needs to admit anyone — the host key it
# proves itself with, the keys it admits — is provisioned, so an image is the
# same on every device and a reflash does not change the host identity.
EXPECT_SSHD_CONFIG=/etc/ssh/sshd_config
EXPECT_SSHD_UNIT=ssh.service
EXPECT_SSHD_UNIT_PATH=/usr/lib/systemd/system/ssh.service
EXPECT_SSHD_ALIAS=sshd.service
EXPECT_SSH_PACKAGE=openssh-server

# The configuration sshd resolves, not the file it is written in: the first
# value obtained for a keyword wins, and the packaged configuration includes
# our directory before it sets anything.
EXPECT_SSHD_SETTINGS="PasswordAuthentication=no
KbdInteractiveAuthentication=no
PermitEmptyPasswords=no
AuthenticationMethods=publickey
PermitRootLogin=prohibit-password
AllowUsers=root
HostKey=/run/brenn/provisioning/ssh/ssh_host_ed25519_key
AuthorizedKeysFile=/run/brenn/provisioning/ssh/authorized_keys
AllowTcpForwarding=no
X11Forwarding=no"

# A device with no host key and no access list has nobody to admit, so it does
# not listen. Serial console is the way in until it has been provisioned.
EXPECT_SSHD_CONDITIONS="/run/brenn/provisioning/ssh/ssh_host_ed25519_key
/run/brenn/provisioning/ssh/authorized_keys"

# Host keys come from provisioning and are never generated. The socket unit is
# masked because one enabled path to sshd is enough to reason about, and the
# conditions live on the service.
EXPECT_SSH_MASKED_UNITS="sshd-keygen.service ssh.socket"

# Log shipping. The journal is volatile, so the upload is how a log survives
# the device; the collector and the trust anchor its certificate is judged
# against are both provisioned.
EXPECT_UPLOAD_UNIT=systemd-journal-upload.service
EXPECT_UPLOAD_UNIT_PATH=/usr/lib/systemd/system/systemd-journal-upload.service
EXPECT_UPLOAD_CONF=/etc/systemd/journal-upload.conf
EXPECT_UPLOAD_PACKAGED_CONF=/usr/lib/systemd/journal-upload.conf
EXPECT_UPLOAD_CONF_DIRS="/etc/systemd/journal-upload.conf.d /usr/lib/systemd/journal-upload.conf.d"
EXPECT_UPLOAD_SOURCE=/run/brenn/provisioning/journal/upload.conf
EXPECT_UPLOAD_PACKAGE=systemd-journal-remote

# TLS needs a clock as much as it needs a route: a device that thinks it is
# 1970 rejects every certificate it is shown.
EXPECT_UPLOAD_AFTER="network-online.target time-sync.target"

# What makes the retry a retry. Removing the start limit is our half; the
# restarting and the growing interval come from the packaged unit, so they are
# read out of the merge — a packaging change that drops them turns the first
# collector outage into log shipping that never comes back.
EXPECT_UPLOAD_BACKOFF_KEYS="RestartSteps RestartMaxDelaySec"

# The same package brings a journal receiver and a journal gateway, both of
# which listen. sshd is the only listener this device has.
EXPECT_UPLOAD_MASKED_UNITS="systemd-journal-remote.service systemd-journal-remote.socket systemd-journal-gatewayd.service systemd-journal-gatewayd.socket"

# The hardware watchdog, at the top of what this one counts to. Without it a
# wedged device stays wedged, and a trial boot that hangs never returns to the
# system it replaced.
EXPECT_WATCHDOG_DROPIN=/etc/systemd/system.conf.d/10-brenn-watchdog.conf
EXPECT_WATCHDOG_RUNTIME=15s

# And the one that covers the shutdown itself: once a reboot has been asked
# for, this is how long it gets before the board is reset anyway. A trial boot
# that hangs on its way out is what it is for.
EXPECT_WATCHDOG_REBOOT=2min

# The OS update mechanism. An update is a signed bundle written to the pair
# that is not running, tried once, and either committed or forgotten; none of
# it can be exercised without hardware, so what is asserted is everything the
# mechanism would be wrong about before it ever runs.
EXPECT_RAUC_PACKAGES="rauc rauc-service dbus"
EXPECT_RAUC_SYSTEM_CONF=/etc/rauc/system.conf
EXPECT_RAUC_COMPATIBLE=brenn-os/cm4
EXPECT_RAUC_BOOTLOADER=custom
EXPECT_RAUC_BUNDLE_FORMATS=verity
EXPECT_RAUC_STATUSFILE=/data/rauc/status.ini

# Where the backend keeps its own two records — which pair has been refused,
# and which pair owes a trial — beside RAUC's status file on the writable
# partition. RAUC never reads them, and neither does its status output, so this
# directory is what answers "was an update tried?" on a device.
EXPECT_RAUC_STATE_DIR=/data/rauc
EXPECT_RAUC_KEYRING=/run/brenn/provisioning/rauc/keyring.pem
EXPECT_RAUC_BACKEND=/usr/lib/rauc/rpi-tryboot-backend

# One transaction at a time, from the update's side: an install is refused
# while a configuration candidate is on trial. RAUC runs this before it writes
# anything and aborts if it fails.
#
# It also records that an install has started, which is the only evidence there
# is during the minutes it takes to write a slot pair — the flag that says an
# update is staged is not armed until the end of it. A configuration change
# refuses on this record. It is on the runtime filesystem, so an install that
# died leaves nothing behind a reboot.
EXPECT_RAUC_PREINSTALL=/usr/lib/brenn/brenn-rauc-preinstall
EXPECT_RAUC_INSTALLING=/run/brenn/rauc-installing

# Every slot, in full: which partition it is, what is on it, and which pair it
# belongs to. Both slots ship byte-identical, so a partition label is the only
# thing that tells them apart — and a wrong one here installs an update over
# the system that is running.
EXPECT_RAUC_SLOTS="slot.rootfs.0|device=/dev/disk/by-partlabel/system_a,type=ext4,bootname=A
slot.boot.0|device=/dev/disk/by-partlabel/boot_a,type=vfat,parent=rootfs.0
slot.rootfs.1|device=/dev/disk/by-partlabel/system_b,type=ext4,bootname=B
slot.boot.1|device=/dev/disk/by-partlabel/boot_b,type=vfat,parent=rootfs.1"

# Nothing but the configuration: a trust anchor in the image would be one every
# device built from it shares, published in a public build.
EXPECT_RAUC_ETC_CONTENTS="system.conf"

# What makes a boot worth keeping, in one place, for both things that replace
# something that was working: an OS update and a configuration change.
#
# The wait for an address is required by name as well as the target it belongs
# to. network-online.target only wants the wait, and a want that failed would
# still leave the target active — so a device that never associates would time
# the wait out and pass the gate anyway, which is exactly the boot that must
# not commit.
EXPECT_HEALTH_TARGET=brenn-healthy.target
EXPECT_HEALTH_REQUIRES="network-online.target systemd-networkd-wait-online.service ssh.service"

# Committing is what ends the trial. Until it happens the firmware still boots
# the previous pair, so a reset at any point returns the device to it.
EXPECT_MARK_GOOD_UNIT=rauc-mark-good.service
EXPECT_MARK_GOOD_EXEC="/usr/bin/rauc status mark-good"

# The gate on every part of the trial machinery: an ordinary boot skips all of
# it and writes nothing at all.
EXPECT_TRYBOOT_CHECK=/usr/lib/brenn/brenn-tryboot-check

# The half of the arming that survives the operator: the reboot, halt and
# poweroff verbs delete the reboot parameter while parsing their arguments, and
# this unit's stop command writes it again on the way down while a staged trial
# is unanswered. It has to be active for the whole boot to be stopped at the end
# of one, which is what RemainAfterExit buys.
EXPECT_REARM_UNIT=brenn-trial-rearm.service
EXPECT_REARM_EXEC=/usr/lib/brenn/brenn-trial-rearm
EXPECT_REARM_REMAIN=yes
EXPECT_REARM_MOUNT=/persistent

# The only thing a trial boot can say before the network exists. There is no
# serial header on this carrier and no journal that survives a reboot, so the
# initramfs of a trial boot writes one file on the selector partition and the
# next boot that comes up reports it into the journal. Its absence after a
# fallback is a reading — the boot died before the initramfs — which is why the
# writer's presence in the shipped initramfs is asserted rather than assumed.
EXPECT_BREADCRUMB_FILE=brenn-trial.log
EXPECT_BREADCRUMB_HOOK=/etc/initramfs-tools/hooks/brenn-trial-breadcrumb
EXPECT_BREADCRUMB_SCRIPT=/etc/initramfs-tools/scripts/local-premount/50-brenn-trial-breadcrumb
EXPECT_TRIAL_REPORT_UNIT=brenn-trial-report.service
EXPECT_TRIAL_REPORT_EXEC=/usr/lib/brenn/brenn-trial-report

# Where the firmware finds the initramfs it loads: on the boot partition of the
# pair being started, under the name auto_initramfs derives from the kernel this
# family boots. The suite reads that copy rather than the root filesystem's,
# because it is the one that runs.
EXPECT_INITRAMFS_PART=boot_a
EXPECT_INITRAMFS_FILE=initramfs8

# What the writer calls, by the path it calls it at, and it needs all eight
# however they arrive. Three of them — od, tr and rmdir — are there because this
# feature's own hook copies them out of the root filesystem; the other five are
# the klibc base utilities every initramfs this builder makes carries. Asserted
# together because a bump that changes which half provides one is exactly what
# takes a tool away silently.
EXPECT_INITRAMFS_TOOLS="/usr/bin/od
/usr/bin/tr
/usr/bin/rmdir
/usr/bin/mkdir
/usr/bin/mount
/usr/bin/umount
/usr/bin/readlink
/usr/bin/sync"

# The submodule's own root-slot check, which reboots the machine when the active
# slot's link is missing. The record has to be written before it runs, or the
# failure it exists for is the one that leaves no evidence.
EXPECT_AB_ROOT_SCRIPT=90-rpi-ab-root

# The candidate the firmware cannot help with: one that comes up, stays up, and
# is useless. The timer is what turns that into a reboot onto the old pair.
EXPECT_DEADMAN_UNIT=brenn-trial-deadman.service
EXPECT_DEADMAN_TIMER=brenn-trial-deadman.timer
EXPECT_DEADMAN_EXEC=/usr/lib/brenn/brenn-trial-deadman
EXPECT_DEADMAN_ONBOOT=$EXPECT_TRIAL_WINDOW

# The timer fires once, so the unit has to be able to try again on its own: the
# deadman reads the selector partition, which the commit running at that same
# moment may have mounted the other way round. One transient failure without
# this leaves the candidate up and unreachable for the rest of the boot.
EXPECT_DEADMAN_RESTART=on-failure
EXPECT_DEADMAN_RESTART_SEC=30s

# A bundle is loop-mounted where it lies, so it is staged on real storage
# rather than in RAM, and the status file needs its directory to exist first.
#
# Both are root-only: a bundle waiting to be installed and the record of which
# slot is trusted are as sensitive as the update mechanism itself, so the mode
# is part of the expectation and not only the owner.
EXPECT_RAUC_TMPFILES=/usr/lib/tmpfiles.d/brenn-rauc.conf
EXPECT_RAUC_TMPFILES_DIRS="/persistent/rauc:0700:root
/persistent/updates:0700:root"

# The application lives in RAM. Everything below is what the image has to
# contain for that to be true on the first boot after a flash, since none of it
# has run on hardware yet.
#
# The mount unit's name is the mount point, escaped the way systemd escapes it;
# a file named anything else is a unit systemd refuses to load.
EXPECT_APP_DIR=/run/brenn-app
EXPECT_APP_MOUNT_UNIT='run-brenn\x2dapp.mount'
EXPECT_APP_MOUNT_WHERE=/run/brenn-app

# Capped, and large enough for a payload with a model in it. A payload that
# outgrows the budget has to fail against this mount rather than against the
# system's memory.
EXPECT_APP_MOUNT_OPTIONS=mode=0755,nosuid,nodev,size=1536M

# Where a payload comes from, and the three programs that put one in place. The
# two an operator invokes are on the path as well, because the documented way
# to reach them is a command over SSH.
EXPECT_APP_FETCH_EXEC=/usr/lib/brenn/brenn-app-fetch
EXPECT_APP_ACTIVATE_EXEC=/usr/lib/brenn/brenn-app-activate
EXPECT_APP_RESYNC_EXEC=/usr/lib/brenn/brenn-app-resync
EXPECT_APP_PATH_LINKS="/usr/sbin/brenn-app-activate
/usr/sbin/brenn-app-resync
/usr/sbin/brenn-config-apply"

# The fetch waits for an address and for a clock, because it makes a TLS
# connection, and for the selection, because that is where the address it
# connects to comes from. An unprovisioned device skips it entirely.
EXPECT_APP_FETCH_UNIT=brenn-app-fetch.service
EXPECT_APP_FETCH_AFTER="network-online.target time-sync.target brenn-config-select.service"
EXPECT_APP_FETCH_CONDITION=/run/brenn/provisioning/app/fetch.conf

# Having a payload is part of what makes a boot worth keeping: an update or a
# configuration change trialled on a boot that could not get one reverts. The
# requirement is contributed to the gate rather than written into it, so the
# gate stays one definition and not an inventory.
EXPECT_APP_FETCH_BEFORE=brenn-healthy.target

# No start limit and no start timeout. The retry is inside the program so that
# the gate can wait for it — a failed start would fail the gate's own job with
# nothing left to re-run it when the server came back.
EXPECT_APP_FETCH_TIMEOUT=infinity
EXPECT_APP_FETCH_START_LIMIT=0

# The contract, as the image implements it: the entry point, the directory it
# runs in, and the three values the payload is told. TMPDIR is the fourth, and
# it points into the same capped RAM as the payload so that a payload writing
# where programs write by habit does not write to flash.
EXPECT_APP_UNIT=brenn-app.service
EXPECT_APP_EXEC=/run/brenn-app/current/run
EXPECT_APP_WORKDIR=/run/brenn-app/current
EXPECT_APP_ENVIRONMENT="BRENN_APP_ROOT=/run/brenn-app/current
BRENN_DATA_DIR=/data/app
BRENN_CA_FILE=/run/brenn/provisioning/ca/brenn-ca.pem
TMPDIR=/run/brenn-app/scratch"

# Unprivileged, always: a payload arrives over the network far more often than
# the image does and with none of its review.
EXPECT_APP_USER=app

# A payload that fails is put back; one that returns success is not, because a
# payload deciding it is finished is not a fault to paper over. The contract
# publishes exactly this, so the unit and the document are pinned to one value.
EXPECT_APP_RESTART=on-failure

# The writable exceptions to a read-only root, by their real paths — /data is a
# symlink, and what is unmasked is the destination.
EXPECT_APP_READWRITE="/run/brenn-app/scratch /persistent/app /persistent/models"

# The directories the runner needs before it can do anything: two in RAM, of
# which only the scratch belongs to the account that runs the payload, and two
# on flash for the rare asset meant to survive a reboot.
#
# The mode is asserted next to the owner, because what keeps an activated
# payload immutable is that the account running it cannot write the directory
# it was unpacked into — which owner alone does not say.
EXPECT_APP_TMPFILES=/usr/lib/tmpfiles.d/brenn-app.conf
EXPECT_APP_TMPFILES_DIRS="/run/brenn-app/releases:0755:root
/run/brenn-app/scratch:0700:app
/persistent/app:0755:app
/persistent/models:0755:app"

# Where a payload is obtained from is site configuration and arrives with the
# generation; an image that named one would be an image for one deployment.
EXPECT_APP_PACKAGES="curl zstd"

# What this image was configured to start on its own, as `<target>/<unit>`, read
# from the enablement links under EXPECT_ENABLED_UNITS_DIR below.
#
# Elsewhere the suite asserts that the units it knows about are wanted, which
# says nothing about the ones it does not: a package's systemd preset enables
# its units at install time, so a layer bump can add a service to every boot
# and no test that names units would notice. What is listed here is the set,
# and a unit appearing or vanishing is a finding rather than a line to update.
#
# The set was reviewed whole. What is not obviously ours:
#   - getty@tty1        the local console; every account is locked, so it
#                       admits nobody, and it is the recovery path a serial
#                       cable reaches
#   - sshd-keygen       wanted by each ssh unit and masked, so the links
#                       resolve to /dev/null and generate nothing
#   - wpa_supplicant    the system-wide instance, masked the same way; the
#                       per-interface instance is the one that runs
#   - fstrim.timer      weekly trim of the writable partitions, which is
#                       flash-health work an appliance wants
#   - remote-fs.target, the systemd baseline: pstore, the network unit
#     systemd-*         generator, resolved and timesyncd
# The apt timers, the dpkg database backup and the e2scrub pair are absent
# because the brenn-cleanup layer removes their links — see it for why each.
EXPECT_ENABLED_UNITS="brenn-healthy.target.requires/brenn-app-fetch.service
getty.target.wants/getty@tty1.service
local-fs.target.wants/persistent-shared-init.service
local-fs.target.wants/run-brenn\x2dapp.mount
local-fs.target.wants/var.mount
multi-user.target.wants/brenn-app.service
multi-user.target.wants/brenn-config-commit.service
multi-user.target.wants/brenn-healthy.target
multi-user.target.wants/brenn-trial-rearm.service
multi-user.target.wants/brenn-trial-report.service
multi-user.target.wants/rauc-mark-good.service
multi-user.target.wants/remote-fs.target
multi-user.target.wants/ssh.service
multi-user.target.wants/systemd-journal-upload.service
multi-user.target.wants/systemd-networkd.service
multi-user.target.wants/wpa_supplicant.service
multi-user.target.wants/wpa_supplicant@wlan0.service
network-online.target.wants/systemd-networkd-wait-online.service
sockets.target.wants/systemd-networkd.socket
ssh.service.wants/sshd-keygen.service
ssh.socket.wants/sshd-keygen.service
sshd.service.wants/sshd-keygen.service
sshd@.service.wants/sshd-keygen.service
sysinit.target.wants/brenn-config-select.service
sysinit.target.wants/machine-id-sync.service
sysinit.target.wants/systemd-network-generator.service
sysinit.target.wants/systemd-pstore.service
sysinit.target.wants/systemd-resolved.service
sysinit.target.wants/systemd-timesyncd.service
timers.target.wants/brenn-config-deadman.timer
timers.target.wants/brenn-trial-deadman.timer
timers.target.wants/fstrim.timer"

# Which enablement links the set above covers. /etc is where enabling a unit
# writes its link — ours by shipping it, a package's by its preset firing during
# the build — so it is the tree that changes when a layer or a dependency
# changes. Packages may also ship static links under /usr/lib/systemd/system,
# which this image carries about fifty of; reviewing that set is
# TODO(vendor-enabled-units).
EXPECT_ENABLED_UNITS_DIR=/etc/systemd/system

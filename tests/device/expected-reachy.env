# What a running reachy unit is expected to look like. Sourced by the device
# tests, alongside the image expectations next door.
#
# Two files because there are two kinds of expectation. What is in the image is
# knowable from the build output and is asserted there; what is in this file is
# only observable once something has booted — what the kernel did with the
# configuration, what the firmware reported, what is actually listening.
#
# Values start as expectations of correct behavior; only a reviewed observation
# replaces them (see the bring-up discipline in CLAUDE.md).

# shellcheck shell=bash disable=SC2034  # consumed by the tests that source this

# The account the lane logs in as. sshd admits exactly this one (see the image
# expectations' AllowUsers), so a device that lets anything else in is a device
# whose configuration is not the one we shipped.
EXPECT_ADMIN_USER=root

# 64-bit, and Debian trixie: the image is built for one architecture and one
# suite, and a device answering anything else is a device still running its
# vendor image — the first thing to rule out when a flash is suspected.
EXPECT_ARCH=aarch64
EXPECT_OS_ID=debian
EXPECT_OS_CODENAME=trixie

# A boot in which nothing failed. Stated as the strict value rather than
# "running or degraded": a failed unit on an appliance is a finding, and the
# test prints which ones so that the finding is legible.
EXPECT_SYSTEM_STATE=running

# The target every filesystem this image mounts hangs off, asserted separately
# because the state above does not cover it: sysinit.target only wants
# local-fs.target, and a subtree that fails to assemble under a Wants is dropped
# from the transaction with nothing logged and nothing failed. A boot that
# reports `running` with this target inactive is a boot in which the firmware
# partition never mounted and the root never took its fstab options.
EXPECT_LOCAL_FS_TARGET=local-fs.target

# The shipped kernel command line as the firmware hands it to the kernel. The
# image suite asserts the file we wrote; this is what survives the firmware,
# which rewrites part of it: `console=serial0` is an alias the firmware resolves
# to the UART actually available, and on this board Bluetooth holds the PL011, so
# the console lands on the mini UART.
#
# Derived from the shipped line rather than restated, because every other token
# is passed through unchanged: a copy would let a token added to the shipped
# line go unasserted on the device while 020 kept passing. If the shipped console
# token ever changes, the substitution stops matching, the serial0 form is
# asserted against /proc/cmdline, and 020 fails on the device — which is the
# right way to hear about it.
#
# The comparison is token membership: the firmware also prepends parameters of
# its own, some of them per-device, and pinning those would make this expectation
# fit one unit.
EXPECT_CMDLINE_RUNTIME="${EXPECT_CMDLINE/console=serial0,115200/console=ttyS0,115200}"

# The mounts backed by a block device, as "target fstype rw|ro". This is the
# invariant the whole product rests on, in one assertion: the two filesystems
# that come out of the A/B pair are read-only, the one writable filesystem is
# the persistent partition, and there is no fourth entry.
#
# Sources are deliberately not compared — which slot is running is not fixed,
# and asserting a partition number here would make the test pass on one slot
# and fail on the other.
EXPECT_BLOCK_MOUNTS="/ ext4 ro
/boot/firmware vfat ro
/persistent ext4 rw"

# Mount points the A/B layout would have given us, and whose units the image
# holds back, because each is a steady write to the flash. Their absence is what
# makes the census above complete rather than coincidental.
EXPECT_ABSENT_MOUNTPOINTS="/home
/bootfs
/var/log/journal"

# The overlay, as the kernel reports it once mounted. The lower half is the
# copy taken during the build; the upper and the work directory are on a tmpfs,
# so everything written to /var after boot is in RAM.
EXPECT_VAR_FSTYPE=overlay
EXPECT_VAR_UPPER_FSTYPE=tmpfs

# The application's filesystem: capped, in RAM, and sized for a payload that
# carries a model. findmnt reports the size in kibibytes.
EXPECT_APP_MOUNT_FSTYPE=tmpfs
EXPECT_APP_MOUNT_SIZE_K=1572864

# The firmware reports which partition it booted, and the slot mapper turns
# that into the links everything else addresses. If these two disagree, the
# device is running one slot and administering the other — which is how an
# update installs over the system performing it.
EXPECT_DT_BOOTLOADER_DIR=/proc/device-tree/chosen/bootloader
EXPECT_SLOT_LINK_DIR=/dev/disk/by-slot
EXPECT_SLOT_LINKS="active/boot
active/system
other/boot
other/system"

# Every TCP socket in the LISTEN state, as "address:port program", sorted.
#
# The invariant is that sshd is the only way in: no other listener is reachable
# from the network. The resolver's stub listeners are on loopback addresses and
# are not reachable from anywhere, but they are listed rather than filtered out
# — an allowlist that quietly excludes a class of address is an allowlist with
# a hole in it, and 127.0.0.53 disappearing is itself worth knowing about.
#
# The `%lo` on the main stub is resolved binding that socket to the loopback
# device, which `ss` renders as a suffix on the address: the stub answers only
# through loopback, narrower than the address alone would promise. The second
# stub on .54 is not device-bound and renders plain — the asymmetry is
# resolved's own, observed on the device.
EXPECT_LISTEN_TCP="0.0.0.0:22 sshd
127.0.0.53%lo:53 systemd-resolve
127.0.0.54:53 systemd-resolve
[::]:22 sshd"

# Every UDP socket bound to a service port, in the same form, sorted, less the
# DHCP clients. Nothing in the LISTEN state exists for a datagram socket, so what
# the device can be held to is the port: below the kernel's ephemeral floor,
# which the test reads from the device, plus the ports named below.
#
# What is deliberately *not* in this set: sockets on ephemeral ports. An
# unconnected UDP socket is what an outbound client looks like while it waits for
# a reply — the resolver's own upstream queries, among others — so counting those
# would make this assertion fail at random on timing, and a census that goes red
# at random is a census that stops being read. A service that pinned itself to a
# port inside the ephemeral range means adding that port to
# EXPECT_LISTEN_UDP_HIGH_PORTS as well as its socket here.
#
# Nor the DHCP clients, which no fixed entry can describe. The v4 client keeps a
# socket on 68 bound to the address it leased, and the v6 client one on 546
# bound to the link's link-local address, which derives from the MAC: one pair
# per managed link that is up, none while a lease is still being acquired, and a
# different address on every unit and every network. The test recognises them by
# owner, port and address class — systemd-network, 68 on a unicast IPv4 address,
# 546 on an address in fe80::/10 — and holds everything else to this set. A
# client bound to a wildcard, or anything else on those ports, is not one of
# them and appears here as unexpected.
#
# It is asserted because one of these is the charter's one exception: the
# multicast-DNS responder that answers the device's own name, on 5353 for both
# address families, which is how a unit on a network the operator does not
# control is found at all. Holding the whole set is what keeps that exception
# the size it was argued for.
#
# Measured on systemd 257. These are the strings ss printed on the unit: the
# responder's second socket as `*:5353` rather than `[::]:5353`, and the stub
# listeners on 53 as the TCP census's addresses without its `%lo`. The census
# compares strings and nothing more. Whether ss prints `*` or `[::]`, and
# whether it appends an interface, depends on what it can read from the kernel
# as well as on the socket, so these entries do not establish whether that
# socket also accepts IPv4 or whether a stub is bound to a device. The spellings
# are held exactly and `*` and `[::]` are not treated as interchangeable: a
# changed spelling, whatever produced it, is a reading to review.
EXPECT_LISTEN_UDP="*:5353 systemd-resolve
0.0.0.0:5353 systemd-resolve
127.0.0.53:53 systemd-resolve
127.0.0.54:53 systemd-resolve"

# The ports inside the ephemeral range the UDP census counts anyway. Empty: the
# responder's 5353 is below the floor and is counted without being named, and
# nothing else on this device pins itself into that range. A service that does
# goes here, beside its socket in the fixed set above.
EXPECT_LISTEN_UDP_HIGH_PORTS=""

# The resolver, named as a unit, because the responder is one of its jobs and a
# stopped resolver is a device with no name on a network nobody's DNS answers
# for.
EXPECT_RESOLVED_UNIT=systemd-resolved.service

# Identity, as the device reports it, all of it from the generation that was
# selected for this boot. The machine id is what the log collector files
# entries under and the host name is what the network registers, so a device
# that generated either of them for itself has lost the identity a reflash is
# supposed to preserve.
EXPECT_SELECT_RESULT=success

# The selected generation, as a path prefix: the store is on the persistent
# partition, and the published link resolves into it and nowhere else.
EXPECT_GENERATION_PREFIX=/persistent/provisioning/gen-

# The carrier's hardware, as the running kernel is expected to report it. Every
# value below is the consequence of one line of the boot configuration the
# image suite reads, which is what makes this suite the other half of that
# assertion: the image says what was asked for, and this says what the hardware
# did with it.
#
# These are expectations written before the first boot. A reading that differs
# is reviewed before anything here is changed to accept it — the bring-up
# discipline in CLAUDE.md — because "the driver bound to a different address"
# and "the overlay did not apply" look identical from a distance.

# The servo bus. The peripheral is at a fixed address on this SoC, so the node
# is named by that address; the platform device the driver binds to is the same
# address in the kernel's own numbering of the low-peripheral window.
EXPECT_UART3_DT_NODE=/proc/device-tree/soc/serial@7e201600
EXPECT_UART3_PLATFORM_DEVICE=fe201600.serial

# The fan controller, as hardware monitoring reports it once the driver has
# claimed it. The reading it exposes is what makes it a fan rather than a
# device that merely probed.
#
# The name is the driver's, not the part's: the boot configuration names the
# emc2301 on this carrier, and the kernel driver registers the family name for
# every variant it handles.
EXPECT_FAN_HWMON_NAME=emc2305
EXPECT_FAN_INPUT=fan1_input

# The head camera, counted through the driver rather than through a video node: a
# video node can exist for a device that never bound, and a bound sensor is what
# this is about. There is one, on the cam0 connector, so the count guards a dead
# sensor in one direction and a second sensor nobody expected in the other.
#
# It does not guard against a connector being declared with nothing attached:
# that declaration costs a failed probe, and a failed probe never binds, so it
# cannot reach this count. That must be caught by name in the boot configuration.
EXPECT_CAMERA_DRIVER=imx708
EXPECT_CAMERA_COUNT=1

# The IMU's bus, by the platform device behind the adapter. Adapter numbering
# depends on probe order and is not an expectation anyone can hold.
EXPECT_IMU_PLATFORM_DEVICE=fe205800.i2c

# The audio board's other half. The USB expectations above are about the board on
# the bus; these are about the sound card the kernel's USB audio driver made of
# it. The image suite asserts the library and the rules file; only a device can
# say that the driver bound, what the card calls itself, and what the nodes came
# up as.
#
# The names the card may present, in the order the application searches them —
# never an index, because index order is probe order and a pipeline that opens
# card 0 works until the day something else enumerates first. Two of them for the
# same reason there are two USB ids above: the board carries the updated
# firmware's name once it has been updated and the module's own name before that,
# and a pre-update board is a configuration this system supports. The first is
# what reachy00 reads today, reviewed before it was baked; the second is matched
# as a substring, case-insensitively, over both lines of the card's entry.
EXPECT_ALSA_CARD_NAMES="Reachy Mini Audio
ReSpeaker"

# Both directions, by the suffix ALSA gives a PCM node. The pipeline captures the
# processed beams and plays back through the same board so the chip's echo
# canceller hears what it emitted, so a card with only one of the two is as
# unusable as no card at all.
EXPECT_ALSA_PCM_DIRECTIONS="c
p"

# The nodes as udev leaves them: reachable by the group the application account
# is in, and by nothing else outside root. Same grant as the USB node above, so
# one group membership covers both ways of reaching this board.
EXPECT_SND_NODE_MODE=0660
EXPECT_SND_NODE_GROUP=audio

# The radio. The interface name is fixed by the kernel's predictable naming for
# the onboard device, and the supplicant runs as the instance for it.
EXPECT_WLAN_INTERFACE=wlan0

# Every link the image configures, as the device names them. The image lane reads
# both link files; the readings that only exist at runtime — what the resolver
# decided per link — are taken over this list, because a setting stated in a file
# that failed to apply to one of them is a link the device cannot be found on.
EXPECT_LINK_INTERFACES="eth0 wlan0"
EXPECT_WPA_STATE=COMPLETED

# No regulatory domain is compiled in or passed on the kernel command line: the
# world domain is what the module reports when nothing has been baked, and the
# country the device actually operates under comes from the provisioned
# supplicant configuration.
EXPECT_REGDOM_MODULE_PARAM=/sys/module/cfg80211/parameters/ieee80211_regdom
EXPECT_REGDOM_MODULE_VALUE=00

# How long the association is deliberately held down before the supplicant is
# told to come back. Long enough that the device is genuinely off the air and
# has to scan and associate again, short enough that a lane running over that
# radio is not left waiting for it.
EXPECT_WIFI_DROP_SECONDS=5

# What the supplicant calls the event, in its own log. This is the record that
# says the disconnection happened at all — the only evidence available from a
# lane that cannot reach the device while the association is down.
EXPECT_WPA_DISCONNECT_EVENT=CTRL-EVENT-DISCONNECTED

# How long the radio gets to come back after being disconnected. Long enough to
# cover a scan of a busy band and a DHCP lease, short enough that a lane that
# is going to fail says so while somebody is still watching.
EXPECT_WIFI_RECONNECT_SECONDS=90

# The clock. A device with no battery-backed clock believes it is 1970 at
# power-on and rejects every certificate it is shown, so being synchronised is
# what makes the TLS consumers work at all.
#
# What is asserted is the service and the synchronisation, and deliberately not
# time-sync.target: with plain timesyncd that target is passive, nothing on this
# image pulls it, and it would be reached at service start rather than at
# synchronisation in any case. Only systemd-time-wait-sync gives it the
# reached-when-set meaning, and enabling that unit would hold startup jobs open
# with no timeout on a device whose network may be absent.
EXPECT_TIMESYNCD_UNIT=systemd-timesyncd.service
EXPECT_NTP_SYNCHRONIZED=yes

# The journal, which is in RAM and nowhere else. The second path is what
# journald creates when persistent storage is in effect, so its absence is the
# runtime half of the volatile setting the image suite reads.
EXPECT_RUNTIME_JOURNAL_DIR=/run/log/journal
EXPECT_PERSISTENT_JOURNAL_DIR=/var/log/journal

# Log shipping, observed rather than configured. The uploader records how far
# the collector has accepted and advances that record only after a transfer
# succeeded, so a marker written into the journal and the record moving past it
# is the device's own evidence of receipt — the only kind available without
# reaching into infrastructure this repository knows nothing about.
#
# The collector's address is site information: only the scheme is compared, and
# it is the one thing about that address this project fixes.
EXPECT_UPLOAD_STATE_FILE=/var/lib/systemd/journal-upload/state
EXPECT_UPLOAD_RECEIPT_SECONDS=120

# How long a record has to become readable in the journal it was written to.
# The write is local and the device is idle, so the window is short: it is here
# to survive the scheduling between two SSH commands, not to wait for anything.
EXPECT_JOURNAL_VISIBLE_SECONDS=15
EXPECT_URL_SCHEME=https://

# The watchdog, as the kernel exposes it once a driver has claimed it. The
# identity is that driver's name for the peripheral; a different one means a
# different watchdog, with a different maximum and different behaviour on
# reset, and is a reading to review rather than to accept.
#
# The hardware timeout is not an independent number: it is what systemd
# programmed from the interval it was configured with, so it is derived from
# that value rather than restated next to it.
# The node systemd opens is the numbered one, which is what it reports having
# taken: "Using hardware watchdog … device /dev/watchdog0". The unnumbered path
# is the compatibility alias, and it is what the device-exists assertion reads.
EXPECT_WATCHDOG_DEVICE=/dev/watchdog
EXPECT_WATCHDOG_PID1_NODE=/dev/watchdog0
EXPECT_WATCHDOG_SYSFS=/sys/class/watchdog/watchdog0
EXPECT_WATCHDOG_IDENTITY="Broadcom BCM2835 Watchdog timer"
EXPECT_WATCHDOG_TIMEOUT=${EXPECT_WATCHDOG_RUNTIME%s}
EXPECT_WATCHDOG_STATE=active

# The flash budget. Steady state is zero writes, and this is where that claim
# is measured rather than asserted: sectors written to the whole device over a
# window in which nothing is meant to be happening.
#
# The limit is zero because that is the target, not because a small number
# would be acceptable. A nonzero reading names a write nobody decided on, and
# gets reviewed before anything here is changed to accept it.
EXPECT_FLASH_STAT_DIR=/sys/block/mmcblk0
EXPECT_IDLE_WINDOW_SECONDS=60
EXPECT_IDLE_WRITE_SECTORS_MAX=0

# Room to be left over the application store's own cap, in kibibytes, for the
# program that will be running out of it. A device that cannot leave this much
# available is a device whose payload does not fit, whatever the store's size
# says.
EXPECT_MEM_HEADROOM_MARGIN_K=262144

# A slot nobody has refused. The update mechanism reports this per slot, from
# the backend, and anything else before the first install means a slot was
# marked bad without one.
EXPECT_RAUC_SLOT_STATUS_GOOD=good

# The baked store, by the path every contract names. Its two directories are
# root's and exist on every device, baked or not, because tmpfiles makes them at
# boot; "root 0755" is `stat -L -c '%U %a'`, following the /data link.
EXPECT_APP_BAKED_STORE_DIRS="/data/baked
/data/baked/releases"
EXPECT_APP_BAKED_STORE_OWNER_MODE="root 755"

# How long a baked boot's fetch may take to be seen skipped. Its condition is
# evaluated only once network-online.target is reached, which on a device with
# no link is the wait-online timeout of 90 s; the rest is margin.
EXPECT_APP_FETCH_SKIP_SECONDS=120

# How long a fetch that was looping through an outage when the device was baked
# may take to end: its longest back-off (300 s) plus its connect timeout (30 s),
# plus margin. It ends on its next attempt, which is where it checks the store.
EXPECT_APP_FETCH_LOOP_END_SECONDS=360

# How long the application gets to be running again after a restart.
EXPECT_APP_RESTART_SECONDS=30
